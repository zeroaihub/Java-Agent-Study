# Enterprise Knowledge Agent V2 — 环境变量示例
# 复制为 .env 并填入真实值。切勿把真实密钥提交到 git!(Ch18 红线)
# 敏感项在生产环境请走 K8s Secret / Vault 注入,而非明文 .env

# ---- 运行环境 ----
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---- PostgreSQL + pgvector(Ch05 / DATABASE.md) ----
DB_URL=jdbc:postgresql://localhost:5432/knowledge_agent
DB_USER=ka
DB_PASSWORD=__CHANGE_ME__

# ---- Elasticsearch / OpenSearch(BM25 检索,Ch05) ----
ES_URIS=http://localhost:9200

# ---- Redis(缓存/配额/限流,Ch16 / Ch17) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__

# ---- 模型密钥(高敏,只走 Secret;此处仅占位)----
OPENAI_API_KEY=__CHANGE_ME__
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=bge-large
RERANK_API_KEY=__CHANGE_ME__
RERANK_MODEL=bge-reranker

# ---- 虚拟线程(Ch17) ----
SPRING_THREADS_VIRTUAL_ENABLED=true

# ---- 优雅停机(Ch19) ----
SERVER_SHUTDOWN=graceful

# ---- 多租户默认套餐(Ch16) ----
DEFAULT_PLAN=FREE

# ---- 可观测性(Ch14) ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0