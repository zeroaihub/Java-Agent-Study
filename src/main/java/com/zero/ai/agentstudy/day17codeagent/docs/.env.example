# Code Agent — 环境变量示例
# 复制为 .env 并填入真实值。切勿把真实密钥提交到 git!(Ch14 红线)
# 敏感项在生产环境请走 K8s Secret / Vault 注入,而非明文 .env

# ---- 运行环境 ----
# 注意:必须是 JDK 而非 JRE,否则 javax.tools.JavaCompiler 不可用(Ch11 自检会失败)
JAVA_HOME=/opt/jdk-21

# ---- 工作目录(三者分离,且非 root 可写,见 DEPLOY.md 第三节)----
CODE_AGENT_VFS_ROOT=/work/vfs
CODE_AGENT_SANDBOX_ROOT=/work/sandbox
CODE_AGENT_CLASSES_ROOT=/work/classes

# ---- 命令沙箱(Ch10) ----
CODE_AGENT_ALLOWED_EXECUTABLES=java,javac
CODE_AGENT_TIMEOUT_MS=30000
CODE_AGENT_MAX_OUTPUT_BYTES=262144
# 生产必须为 false:一旦继承,生成的代码可以 System.getenv() 把密钥打出来
CODE_AGENT_INHERIT_ENV=false

# ---- 自修复循环(Ch13) ----
CODE_AGENT_MAX_REPAIR_ROUNDS=3
# 无进展检测:两轮错误签名相同即早停,建议始终开启
CODE_AGENT_STOP_ON_NO_PROGRESS=true

# ---- 预算护栏(Ch19) ----
CODE_AGENT_MAX_TOKENS=20000
CODE_AGENT_MAX_MODEL_CALLS=6
CODE_AGENT_MAX_WALL_CLOCK_MS=300000
CODE_AGENT_PRICE_PER_1K_TOKENS=0.03

# ---- 上下文预算(Ch06) ----
CODE_AGENT_CONTEXT_TOTAL=32768
CODE_AGENT_CONTEXT_SYSTEM_RESERVE=1000
CODE_AGENT_CONTEXT_OUTPUT_RESERVE=4000
CODE_AGENT_CONTEXT_HISTORY_RESERVE=8000

# ---- 安全护栏(Ch14) ----
# 受保护路径(逗号分隔),命中即 REJECT
CODE_AGENT_FORBIDDEN_PATHS=.github/workflows/,.env,Jenkinsfile,.gitlab-ci
# 单次补丁删除行数上限
CODE_AGENT_MAX_REMOVED_LINES=200

# ---- 模型(高敏,只走 Secret;此处仅占位)----
CODE_AGENT_MODEL_ID=stub-code-model-1.0
CODE_AGENT_MODEL_API_KEY=__CHANGE_ME__
CODE_AGENT_MODEL_BASE_URL=__CHANGE_ME__

# ---- 可观测性(Ch19) ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
CODE_AGENT_TRACE_SAMPLING_PROBABILITY=1.0
